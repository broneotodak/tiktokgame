# TikTok Live Overlay Configuration
# Copy this to .env and fill in your values

# Your TikTok username (without @)
TIKTOK_USERNAME=your_username

# EulerStream API Key (required for TikTok connection)
# Get free key at: https://www.eulerstream.com/
EULER_API_KEY=your_euler_api_key_here

# Server port
PORT=3000
import { NextResponse } from 'next/server';
import OpenAI from 'openai';

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

// Helper function to get western Zodiac sign
function getZodiacSign(day: number, month: number): string {
  const signs = [
    { sign: 'Capricorn', month: 1, day: 20 },
    { sign: 'Aquarius', month: 2, day: 19 },
    { sign: 'Pisces', month: 3, day: 20 },
    { sign: 'Aries', month: 4, day: 20 },
    { sign: 'Taurus', month: 5, day: 21 },
    { sign: 'Gemini', month: 6, day: 21 },
    { sign: 'Cancer', month: 7, day: 23 },
    { sign: 'Leo', month: 8, day: 23 },
    { sign: 'Virgo', month: 9, day: 23 },
    { sign: 'Libra', month: 10, day: 23 },
    { sign: 'Scorpio', month: 11, day: 22 },
    { sign: 'Sagittarius', month: 12, day: 22 },
    { sign: 'Capricorn', month: 12, day: 31 },
  ];

  for (const s of signs) {
    if (month === s.month && day <= s.day) return s.sign;
    if (month === s.month - 1 && day > signs[month - 2]?.day) return s.sign;
  }
  return 'Capricorn';
}

export async function POST(req: Request) {
  try {
    const { name, dob, timeOfBirth, placeOfBirth, focusArea, gender } = await req.json();

    if (!name || !dob) {
      return NextResponse.json({ error: 'Missing required birth details.' }, { status: 400 });
    }

    const birthDate = new Date(dob);
    const day = birthDate.getUTCDate();
    const month = birthDate.getUTCMonth() + 1;
    const zodiacSign = getZodiacSign(day, month);

    const systemPrompt = `You are a master Vedic & Western Astrologer with 30+ years of esoteric wisdom. 
Provide an insightful, mystical, yet grounded astrological forecast.
Structure your JSON response strictly in the following format:
{
  "sunSign": "${zodiacSign}",
  "coreEssence": "2-3 sentences summarizing their core personality & soul archetype",
  "careerAndFinances": "Prediction and advice for career, wealth, and opportunities over the next 12-24 months",
  "loveAndRelationships": "Prediction and insights for love, soulmates, and family life",
  "healthAndEnergy": "Guidance on vitality, mental energy, and wellness",
  "majorMilestones": ["Milestone 1 (Estimated timeframe)", "Milestone 2", "Milestone 3"],
  "remedy": "A sacred gemstone, mantra, or daily cosmic practice to attract luck",
  "luckyElements": {
    "color": "Lucky Color",
    "number": "Lucky Number",
    "direction": "Favorable Direction"
  }
}`;

    const userPrompt = `Generate a comprehensive astrological prediction for:
- Name: ${name}
- Gender: ${gender || 'Not specified'}
- Date of Birth: ${dob}
- Time of Birth: ${timeOfBirth || 'Unknown / General Noon'}
- Place of Birth: ${placeOfBirth || 'Not specified'}
- Primary Question / Focus Area: ${focusArea || 'General Life Path'}
- Calculated Sun Sign: ${zodiacSign}`;

    const response = await openai.chat.completions.create({
      model: 'gpt-4o',
      response_format: { type: 'json_object' },
      temperature: 0.7,
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userPrompt },
      ],
    });

    const prediction = JSON.parse(response.choices[0].message.content || '{}');
    return NextResponse.json({ success: true, data: prediction });
  } catch (error: any) {
    console.error('Astrology API Error:', error);
    return NextResponse.json({ error: 'Failed to consult the cosmos. Try again later.' }, { status: 500 });
  }
}
